{
  "name": "dsh-archive-drawer",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：侧边栏加一个「归档」面板，集中查看已归档对话、一键恢复，归档时自动生成一份上下文总结。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjl2006/dsh-archive-drawer.git"
  },
  "homepage": "https://github.com/hjl2006/dsh-archive-drawer#readme",
  "bugs": {
    "url": "https://github.com/hjl2006/dsh-archive-drawer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "session",
    "summary",
    "归档"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}